diff --git a/include/qemu/event_notifier.h b/include/qemu/event_notifier.h
index 8a4ff308e1..bf3920b225 100644
--- a/include/qemu/event_notifier.h
+++ b/include/qemu/event_notifier.h
@@ -33,6 +33,16 @@ typedef void EventNotifierHandler(EventNotifier *);
 int event_notifier_init(EventNotifier *, int active);
 void event_notifier_cleanup(EventNotifier *);
 int event_notifier_set(EventNotifier *);
+
+#ifdef __EMSCRIPTEN__
+/*
+ * Bumped (and futex-woken) by every event_notifier_set(). qemu_poll_ns()
+ * waits on it instead of calling poll(): under -pthread emscripten proxies
+ * poll() to the main thread, where with ASYNCIFY it is an async import that
+ * aborts when reached through the proxy.
+ */
+extern uint32_t qemu_wasm_notify_seq;
+#endif
 int event_notifier_test_and_clear(EventNotifier *);
 
