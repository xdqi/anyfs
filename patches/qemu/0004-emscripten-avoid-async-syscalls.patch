index 83fdbb96bb..f6c2a95453 100644
--- a/util/event_notifier-posix.c
+++ b/util/event_notifier-posix.c
@@ -19,6 +19,11 @@
 #ifdef CONFIG_EVENTFD
 #include <sys/eventfd.h>
 #endif
+#ifdef __EMSCRIPTEN__
+#include <emscripten/threading.h>
+
+uint32_t qemu_wasm_notify_seq;
+#endif
 
 #ifdef CONFIG_EVENTFD
 /*
@@ -121,6 +126,10 @@ int event_notifier_set(EventNotifier *e)
     if (ret < 0 && errno != EAGAIN) {
         return -errno;
     }
+#ifdef __EMSCRIPTEN__
+    qatomic_inc(&qemu_wasm_notify_seq);
+    emscripten_futex_wake(&qemu_wasm_notify_seq, INT_MAX);
+#endif
     return 0;
 }
 
diff --git a/util/osdep.c b/util/osdep.c
index 4a8b8b5a90..522c67b110 100644
--- a/util/osdep.c
+++ b/util/osdep.c
@@ -613,7 +613,12 @@ writev(int fd, const struct iovec *iov, int iov_cnt)
  */
 int qemu_fdatasync(int fd)
 {
-#ifdef CONFIG_FDATASYNC
+#if defined(CONFIG_FDATASYNC) || defined(__EMSCRIPTEN__)
+    /*
+     * emscripten: fsync() is an async syscall (fd_sync) that aborts when a
+     * pthread proxies it to the main thread under ASYNCIFY; fdatasync() is
+     * a synchronous no-op there, since its file systems hold no dirty state.
+     */
     return fdatasync(fd);
 #else
     return fsync(fd);
