@@ -156,6 +156,12 @@ void qemu_notify_event(void)
 }
 
 static GArray *gpollfds;
+static GMainContext *main_loop_gcontext;
+
+void qemu_main_loop_set_gcontext(GMainContext *ctx)
+{
+    main_loop_gcontext = ctx;
+}
 
 int qemu_init_main_loop(Error **errp)
 {
@@ -178,11 +184,11 @@ int qemu_init_main_loop(Error **errp)
     gpollfds = g_array_new(FALSE, FALSE, sizeof(GPollFD));
     src = aio_get_g_source(qemu_aio_context);
     g_source_set_name(src, "aio-context");
-    g_source_attach(src, NULL);
+    g_source_attach(src, main_loop_gcontext);
     g_source_unref(src);
     src = iohandler_get_g_source();
     g_source_set_name(src, "io-handler");
-    g_source_attach(src, NULL);
+    g_source_attach(src, main_loop_gcontext);
     g_source_unref(src);
     return 0;
 }
