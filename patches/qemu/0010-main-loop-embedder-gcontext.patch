diff --git a/include/qemu/main-loop.h b/include/qemu/main-loop.h
index 8c1241a2c1..a27acfd84b 100644
--- a/include/qemu/main-loop.h
+++ b/include/qemu/main-loop.h
@@ -54,6 +54,19 @@ typedef struct MainLoop MainLoop;
  */
 int qemu_init_main_loop(Error **errp);
 
+/**
+ * qemu_main_loop_set_gcontext: Choose the GMainContext for the main loop.
+ *
+ * By default qemu_init_main_loop() attaches the main AioContext and the
+ * iohandler GSources to the global default GMainContext.  A program that
+ * embeds the block layer next to its own GLib main loop (for example
+ * Electron/Chromium, which iterates g_main_context_default()) must keep
+ * QEMU's sources off that loop and run aio_poll() itself.  Call this before
+ * qemu_init_main_loop() to attach the sources to @ctx instead.  Passing NULL
+ * restores the default behaviour.
+ */
+void qemu_main_loop_set_gcontext(GMainContext *ctx);
+
 /**
  * main_loop_wait: Run one iteration of the main loop.
  *
diff --git a/util/main-loop.c b/util/main-loop.c
