+/* Filenames are UTF-8 (embedders pass them that way); the ANSI CreateFile
+ * would read them in the system code page. */
+static HANDLE win32_create_file_utf8(const char *filename, DWORD access,
+                                     DWORD share, DWORD disposition,
+                                     DWORD flags)
+{
+    wchar_t *w = g_utf8_to_utf16(filename, -1, NULL, NULL, NULL);
+    HANDLE h;
+
+    if (!w) {
+        SetLastError(ERROR_INVALID_NAME);
+        return INVALID_HANDLE_VALUE;
+    }
+    h = CreateFileW(w, access, share, NULL, disposition, flags, NULL);
+    g_free(w);
+    return h;
+}
+
